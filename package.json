{
  "name": "brackenvale",
  "version": "0.0.0",
  "description": "Brackenvale — a top-down pixel-art action RPG (TypeScript + Vite + Phaser)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sprites": "node scripts/gif-to-sheets.mjs"
  },
  "dependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "omggif": "^1.0.10",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
